{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "height": 15,
    "padding": {
      "top": 3,
      "left": 2,
      "right": 2
    },
    "color": {
      "1": "#76c6bc",
      "2": "#3c5d59",
      "3": "#c2d6d4",
      "4": "#e8e6e3",
      "5": "#2f261a",
      "6": "#372c1d",
      "7": "#3c3120",
      "8": "#e8e6e3",
      "9": "#c0bbb5"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "#76c6bc"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": " ",
      "keyColor": "#76c6bc"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "#76c6bc"
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "display",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "white"
    },
    {
      "type": "swap",
      "key": "󰾴 ",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "white"
    },
    {
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "key": "󱦟 ",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "format": "{6}",
      "key": " ",
      "keyColor": "#de9d5e"
    },
    {
      "type": "custom",
      "shell": "echo '󰣐󰣐󰣐'",
      "key": " ",
      "keyColor": "#de9d5e"
    }
  ]
}
