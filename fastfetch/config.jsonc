{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "height": 15,
    "padding": {
      "top": 3,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "󰾴 ",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "󱦟 ",
      "keyColor": "cyan",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "key": " palette",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "cyan"
    },
    "break",
    "break"
  ]
}