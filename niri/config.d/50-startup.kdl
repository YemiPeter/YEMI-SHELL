// ─────────────────────────────────────────────────────────────────────────────
// 50 — Processes spawned at login
// ─────────────────────────────────────────────────────────────────────────────
// Each line runs once when Niri starts. For daemons that support it,
// xdg-desktop-autostart (systemd) is an alternative.
//
// Tip: use spawn-sh-at-startup for shell pipelines or variable expansion.
// ─────────────────────────────────────────────────────────────────────────────

// Export XDG_MENU_PREFIX into the systemd user session and rebuild the
// sycoca database so KDE/Qt apps see the correct .desktop entries.
spawn-at-startup "bash" "-c" "systemctl --user import-environment XDG_MENU_PREFIX && kbuildsycoca6"

// Clipboard history: wl-paste watches the clipboard and cliphist stores it.
// Using type-specific watchers prevents duplicate entries (browsers offer both
// text/html and text/plain — without --type, cliphist stores both).
// Access via iNiR's clipboard overlay (Mod+V).
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store &"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store &"

// Polkit authentication agent — handled by the shell's own PolkitService
// (services/PolkitService.qml), which best-effort registers Quickshell's agent
// and backs off if another agent (mate-polkit, polkit-kde, etc.) is already
// running. Launching mate-polkit here too creates a duplicate authority, so it
// is disabled in favour of the shell-managed agent.
// spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"

// ── YemiShell (quickshell) ─────────────────────────────────────────────────
// Started here via niri's spawn-at-startup. (The old iNiR setup referenced an
// inir.service systemd unit, but that no longer exists, and quickshell was
// otherwise only launched manually — so the desktop never came back after a
// reboot where niri failed to stay up.) niri sets WAYLAND_DISPLAY before this
// runs, so quickshell connects to the compositor automatically.
spawn-at-startup "quickshell" "-p" "/home/yemi/.config/quickshell/shell.qml"
