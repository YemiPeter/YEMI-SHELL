// ─────────────────────────────────────────────────────────────────────────────
// 71 — Waffle-family key bindings
// ─────────────────────────────────────────────────────────────────────────────
//
// Sourced AFTER 70-binds.kdl so waffle binds override matching pill binds.
// Each waffle component registers an IpcHandler target (see bar button QML
// files under modules/waffle/bar/). Keybinds below call those IPC targets
// via `qs ipc call <target> <function>`.
//
// ─────────────────────────────────────────────────────────────────────────────
// SECTION 1 — LAUNCHER (Start Menu / Search)
// ─────────────────────────────────────────────────────────────────────────────

// Same key as the pill launcher in 70-binds.kdl (Mod+Space) so there is no
// keybind mismatch between the two panel families.
// Routes through the family-aware `app` IpcHandler in shell.qml:
//   pill   -> pill launcher (PillState.toggleSurface)
//   waffle -> waffle start menu (GlobalStates.searchOpen)
//
// SECTION 2 — ALT+SWITCHER (Windows-style Alt+Tab)
// Overrides pill's Alt+Tab (70-binds.kdl) while waffle is the active family.
// `waffleAltSwitcher` IpcHandler is registered by WaffleAltSwitcher.qml (loaded
// only under panelFamily === "waffle"). Under pill this target is absent, so
// keep pill's Alt+Tab by NOT extending Shift here unless you want it overridden.
binds {
    Mod+Space repeat=false { spawn "qs" "ipc" "call" "app" "launcher"; }                            // Start menu / launcher (family-aware: pill launcher / waffle search)

    // Toggle between the Pill and Waffle panel families.
    // The `desktop` IpcHandler is defined in shell.qml (target "desktop",
    // function toggle()) and flips panelFamily pill <-> waffle.
    Mod+P repeat=false { spawn "qs" "ipc" "call" "desktop" "toggle"; }                            // Toggle Pill / Waffle

    Alt+Tab { spawn "qs" "ipc" "call" "waffleAltSwitcher" "next"; }                                 // Alt+Tab switcher (next) — repeat=true so holding keeps it open
    Alt+Shift+Tab { spawn "qs" "ipc" "call" "waffleAltSwitcher" "previous"; }                       // Alt+Shift+Tab (previous)

    // ─────────────────────────────────────────────────────────────────────────
    // SECTION 3 — WAFFLE PANEL IPC TARGETS
    // Each target is registered by its waffle component (loaded only under
    // panelFamily === "waffle"), so these binds are inert while pill is active.
    // ─────────────────────────────────────────────────────────────────────────

    // Taskbar cluster (wired in waffle mode; the same keys already drive pill
    // surfaces under 70-binds.kdl, so muscle memory carries across families).
    Mod+A          { spawn "qs" "ipc" "call" "wactionCenter" "toggle"; }           // Action Center (SystemButton)
    Mod+N          { spawn "qs" "ipc" "call" "wnotificationCenter" "toggle"; }     // Notification Center (TimeButton)
    Mod+Z          { spawn "qs" "ipc" "call" "wwidgets" "toggle"; }                // Widgets (Weather/Timer buttons)
    Mod+Tab        { spawn "qs" "ipc" "call" "taskview" "toggle"; }               // Task View (TaskViewButton)
    Mod+B          { spawn "qs" "ipc" "call" "wbar" "toggle"; }                   // Bar show/hide

    // Clipboard picker (also Mod+C like iNiR; overrides pill's Mod+C clipboard
    // bind while waffle is active since 71 is sourced after 70).
    Mod+C          { spawn "qs" "ipc" "call" "clipboard" "toggle"; }              // Clipboard (waffle)

    // Session / power screen.
    Mod+Shift+Q    { spawn "qs" "ipc" "call" "session" "toggle"; }                // Session screen

    // Lock screen. allow-when-locked lets the key work on the lock surface too.
    Mod+Alt+L      allow-when-locked=true  { spawn "qs" "ipc" "call" "lock" "activate"; }
    Mod+Ctrl+Shift+L allow-when-locked=true { spawn "qs" "ipc" "call" "lock" "focus"; }

    // Region / screenshot toolbar (waffle variant).
    Mod+Shift+S    { spawn "qs" "ipc" "call" "region" "screenshot"; }             // Screenshot
    Mod+Shift+X    { spawn "qs" "ipc" "call" "region" "ocr"; }                    // OCR
    Mod+Shift+A    { spawn "qs" "ipc" "call" "region" "search"; }                 // Visual search

    // Cycle panel family (waffle <-> pill). Added by the `panelFamily` IpcHandler
    // in shell.qml (GATE-2, Phase F). If that target is not yet present this bind
    // is a no-op until the handler lands.
    Mod+Shift+W    { spawn "qs" "ipc" "call" "panelFamily" "cycle"; }             // Cycle Pill / Waffle
}
