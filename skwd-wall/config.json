{
  "compositor": "hyprland",
  "monitor": "",
  "general": {
    "locale": "",
    "closeOnSelection": false,
    "reopenAtLastSelection": false
  },
  "paths": {
    "wallpaper": "~/Pictures/Wallpapers",
    "videoWallpaper": "~/videowalls",
    "cache": "",
    "templates": "",
    "scripts": "",
    "steam": "",
    "steamWorkshop": "",
    "steamWeAssets": ""
  },
  "features": {
    "matugen": false,
    "ollama": false,
    "steam": false,
    "wallhaven": true,
    "videoPreviewInstant": true
  },
  "colorSource": "magick",
  "ollama": {
    "url": "http://localhost:11434",
    "model": "gemma3:4b",
    "consolidateEnabled": true
  },
  "steam": {
    "apiKey": "",
    "username": ""
  },
  "wallhaven": {
    "apiKey": ""
  },
  "matugen": {
    "schemeType": "scheme-fidelity",
    "mode": "light"
  },
  "integrations": [
    {
      "_comment": "Built-in: MD3 colors for the shell UI (always needed)",
      "name": "skwd-wall",
      "template": "quickshell-colors.json",
      "output": "colors.json"
    },
    {
      "_comment": "MD3 colors for the Skwd shell widgets (skwd-bar etc)",
      "name": "skwd",
      "template": "quickshell-colors.json",
      "output": "~/.cache/skwd/colors.json"
    }
  ],
  "components": {
    "wallpaperSelector": {
      "displayMode": "hex",
      "sliceSpacing": -30,
      "hexScrollStep": 3,
      "customPresets": {
        "C1_slices": {
          "expandedWidth": 800,
          "sliceHeight": 270,
          "sliceWidth": 68,
          "visibleCount": 18,
          "sliceSpacing": -30,
          "skewOffset": 20
        },
        "C2_slices": {
          "expandedWidth": 800,
          "sliceHeight": 270,
          "sliceWidth": 68,
          "visibleCount": 18,
          "sliceSpacing": -30,
          "skewOffset": 20
        }
      },
      "roundCorners": true,
      "expandedWidth": 768,
      "sliceHeight": 432,
      "sliceWidth": 108,
      "visibleCount": 14,
      "skewOffset": 28,
      "hexRadius": 100,
      "hexRows": 6,
      "hexCols": 10,
      "hexArc": true,
      "hexArcIntensity": 1,
      "gridThumbWidth": 200,
      "gridThumbHeight": 100,
      "gridColumns": 9,
      "gridRows": 6
    }
  },
  "wallpaperMute": true,
  "pickOnlyMode": true,
  "restoreOnStartup": false,
  "externalWallpaperCommand": "~/.config/hypr/scripts/wallpaper.sh set %path% && ~/.config/skwd-wall/scripts/sync-colors.sh %path%",
  "postProcessing": [],
  "performance": {
    "imageOptimizePreset": "quality",
    "imageOptimizeResolution": "1080p",
    "videoConvertPreset": "balanced",
    "videoConvertResolution": "2k",
    "autoOptimizeImages": true,
    "autoConvertVideos": false,
    "imageTrashDays": 7,
    "videoTrashDays": 7,
    "autoDeleteImageTrash": false,
    "autoDeleteVideoTrash": false
  },
  "paper": {
    "engine": "awww",
    "awww": {
      "transitionType": "fade",
      "transitionDuration": 0.8,
      "transitionFps": 120,
      "filter": "Bilinear"
    }
  },
  "display": {
    "fillMode": "fill"
  }
}
